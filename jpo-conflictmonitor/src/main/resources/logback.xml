<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<jmxConfigurator />

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%date{"yyyy-MM-dd HH:mm:ss.SSS", UTC} [%thread] %-5level %logger{0} - %msg %n</pattern>
		</encoder>
	</appender>
	<logger name="us.dot.its.jpo.conflictmonitor.monitor.utils" level="WARN"/>
	<logger name="us.dot.its.jpo.conflictmonitor" level="WARN"/>
	<root level="ERROR">
		<appender-ref ref="STDOUT" />
	</root>
</configuration>
